# Docker Compose reads this configuration from the repository root .env.
# If .env already exists, add these settings without replacing its contents.
POSTGRES_USER=axis_user
POSTGRES_DB=axis_db
POSTGRES_PASSWORD=replace-with-your-local-database-password
WEB_PORT=8080

# Fully offline by default; all integration inputs are mock fixtures.
EXTRACTION_MODE=fixture
EXPLANATION_MODE=rules
# Optional Gemini settings, used only when the relevant mode is "gemini".
GEMINI_API_KEY=
GEMINI_MODEL=
