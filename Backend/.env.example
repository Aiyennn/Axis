# Copy to Backend/.env. Never commit actual credentials.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/axis_db
# Offline demo: no provider calls. Use gemini to enable AI explanations.
EXPLANATION_MODE=rules
EXTRACTION_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=
# Enable secure cookies when serving through HTTPS.
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
